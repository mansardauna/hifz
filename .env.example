# ==============================================================================
# HIFZ MULTI-TENANT SAAS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Database Connection (PostgreSQL: Supabase, Neon, AWS RDS, PlanetScale)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hifz_lms?schema=public"

# 2. Authentication & JWT Sessions
# Generate secure random secret with: openssl rand -base64 32
JWT_SECRET="generate-production-random-jwt-secret-32-chars-minimum"
NEXTAUTH_SECRET="generate-production-random-jwt-secret-32-chars-minimum"
NEXTAUTH_URL="https://hifz.app"

# 3. LiveKit Cloud WebRTC SFU (Video Classroom & Screen Sharing)
# Obtain credentials from: https://cloud.livekit.io
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="wss://live.hifz.app"

# 4. Stripe Connect Billing (Global Credit / Debit Cards)
# Keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 5. Moyasar Gateway (Saudi Arabia & GCC: Mada, Apple Pay, STC Pay)
# Keys from: https://dashboard.moyasar.com
MOYASAR_API_KEY="sk_live_..."
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY="pk_live_..."

# 6. Optional: External Custom Backend API (PHP / Laravel / Node)
# Leave empty to use Next.js internal /api route handlers
NEXT_PUBLIC_API_URL="/api"
# NEXT_PUBLIC_PHP_API_URL="https://api.yourdomain.com/api"

# 7. Wildcard Subdomain Routing & Edge Deployment
# Next.js custom domain multi-tenancy host root
NEXT_PUBLIC_ROOT_DOMAIN="hifz.app"
NODE_ENV="production"

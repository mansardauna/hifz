# ==========================================
# HIFZ PLATFORM PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# 1. DATABASE (Prisma + PostgreSQL)
# Direct connection URI from Supabase / Neon / Railway PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.supabase.co:5432/postgres?sslmode=require"

# 2. AUTHENTICATION & JWT SECURITY
# Generate a strong 64-character secret with: openssl rand -base64 32
JWT_SECRET="YOUR_LONG_RANDOM_JWT_SECRET_KEY_HERE_FOR_TOKEN_SIGNING"

# 3. LIVEKIT CLOUD (WebRTC Video Conferencing & Whiteboard)
# Register free at: https://cloud.livekit.io
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# 4. STRIPE (Global Cards, Apple Pay, Google Pay)
# Register at: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# 5. MOYASAR PAYMENTS (Saudi Mada, GCC & Apple Pay)
# Register at: https://dashboard.moyasar.com
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY="YOUR_MOYASAR_PUBLISHABLE_KEY"
MOYASAR_SECRET_KEY="YOUR_MOYASAR_SECRET_KEY"

# 6. RESEND (Transactional Emails & Tuition Receipts)
# Register at: https://resend.com
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="admissions@yourdomain.com"

# 7. OPENAI (Acoustic Whisper Speech-to-Text for Recitation Tajweed)
# Register at: https://platform.openai.com
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# 8. MULTI-TENANT DOMAIN ROUTING
# Root domain for subdomains (e.g., madrasah.hifz.app)
NEXT_PUBLIC_ROOT_DOMAIN="hifz.app"

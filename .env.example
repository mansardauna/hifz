# ==========================================
# ANKABIT LMS ENTERPRISE BACKEND CONFIGURATION
# ==========================================

# 1. PRIMARY POSTGRESQL DATABASE & POOLER (Prisma ORM)
# Pooled connection string (PgBouncer / AWS RDS / Neon / DigitalOcean)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db-cluster.internal:5432/ankabit_lms_production?sslmode=require&connection_limit=25"
# Direct unpooled connection string (for Prisma schema migrations)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db-cluster.internal:5432/ankabit_lms_production"

# 2. REDIS CACHE & DISTRIBUTED SESSION STORE
REDIS_URL="rediss://default:YOUR_REDIS_PASSWORD@redis-cache.internal:6379"

# 3. S3 / CLOUDFLARE R2 OBJECT STORAGE & CDN
S3_PROVIDER="cloudflare_r2"
S3_BUCKET_NAME="ankabit-quran-assets"
S3_REGION="auto"
S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="YOUR_S3_R2_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_S3_R2_SECRET_ACCESS_KEY"
NEXT_PUBLIC_CDN_URL="https://cdn.ankabit.app"

# 4. AUTHENTICATION & JWT SECURITY
# Generate a strong 64-character secret with: openssl rand -base64 32
JWT_SECRET="YOUR_LONG_RANDOM_JWT_SECRET_KEY_HERE_FOR_TOKEN_SIGNING"

# 5. LIVEKIT SFU CLUSTER (WebRTC High-Capacity Virtual Classroom)
LIVEKIT_URL="wss://livekit.ankabit.app"
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"

# 6. STRIPE BILLING ENGINE (Cards, Apple Pay, Subscriptions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"

# 7. MOYASAR GATEWAY (Saudi Mada, GCC & Apple Pay)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY="YOUR_MOYASAR_PUBLISHABLE_KEY"
MOYASAR_SECRET_KEY="YOUR_MOYASAR_SECRET_KEY"

# 8. MULTI-CHANNEL COMMUNICATIONS (Email & WhatsApp)
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="admissions@ankabit.app"

# 9. MULTI-TENANT DOMAIN ROUTING
NEXT_PUBLIC_ROOT_DOMAIN="ankabit.app"

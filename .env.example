# ==============================================================================
# ANKABIT LMS ENTERPRISE ENVIRONMENT CONFIGURATION (.env.example)
# Multi-Tenant Academy SaaS Platform (1M+ Scale)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM - MySQL / MariaDB 10.11+)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?connection_limit=25&pool_timeout=30
DATABASE_URL="mysql://your_db_user:your_strong_password@localhost:3306/ankabit_lms?connection_limit=25&pool_timeout=30"

# Optional credentials if using docker-compose.yml defaults
DB_ROOT_PASSWORD="your_root_password_placeholder"
DB_NAME="ankabit_lms"
DB_USER="ankabit"
DB_PASSWORD="your_db_password_placeholder"

# ------------------------------------------------------------------------------
# 2. REDIS DISTRIBUTED CACHE & SESSION STORE
# ------------------------------------------------------------------------------
REDIS_URL="redis://:your_redis_password_placeholder@localhost:6379"
REDIS_PASSWORD="your_redis_password_placeholder"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret with: openssl rand -base64 32
JWT_SECRET="generate_a_secure_random_64_char_secret_key_here"
NEXTAUTH_SECRET="generate_a_secure_random_64_char_secret_key_here"

# ------------------------------------------------------------------------------
# 4. LIVEKIT WEBRTC SFU (High-Capacity Virtual Classroom & Halaqah)
# ------------------------------------------------------------------------------
# Option A: LiveKit Cloud (Recommended for global auto-scaling: https://livekit.io)
# Option B: Self-Hosted SFU (wss://livekit.yourdomain.com:7880)
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key_placeholder"
LIVEKIT_API_SECRET="your_livekit_api_secret_placeholder"

# Optional Geo-Distributed Endpoints (for multi-region halaqat)
LIVEKIT_URL_EU="wss://eu-media.ankabit.app"
LIVEKIT_URL_ME="wss://me-media.ankabit.app"
LIVEKIT_URL_US="wss://us-media.ankabit.app"

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT GATEWAY (International Cards, Apple Pay, Subscriptions)
# ------------------------------------------------------------------------------
# Get from Stripe Dashboard: https://dashboard.stripe.com/apikeys
# Use 'pk_live_...' and 'sk_live_...' in production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_sample_stripe_secret_key"
# Webhook secret from Stripe Dashboard -> Developers -> Webhooks -> Add endpoint (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_sample_stripe_webhook_signing_secret"

# ------------------------------------------------------------------------------
# 6. MOYASAR GATEWAY (Saudi Mada, GCC Debit/Credit, Apple Pay)
# ------------------------------------------------------------------------------
# Get from Moyasar Dashboard: https://dashboard.moyasar.com
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY="pk_test_sample_moyasar_key"
MOYASAR_SECRET_KEY="sk_test_sample_moyasar_secret"

# ------------------------------------------------------------------------------
# 7. CLOUDFLARE R2 / S3 OBJECT STORAGE (Certificates, Audio Recitations, Logos)
# ------------------------------------------------------------------------------
# Get from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ankabit-lms-assets"
R2_PUBLIC_DOMAIN="media.ankabit.app"

# ------------------------------------------------------------------------------
# 8. MULTI-CHANNEL COMMUNICATIONS (Transactional Email & Meta WhatsApp API)
# ------------------------------------------------------------------------------
# Resend API for onboarding emails & payment receipts: https://resend.com
RESEND_API_KEY="re_sample_resend_api_key"
EMAIL_FROM="admissions@ankabit.app"

# Meta WhatsApp Cloud API (Automated halaqah attendance & parent notices)
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_verification_secret_token"

# ------------------------------------------------------------------------------
# 9. MULTI-TENANT DOMAIN ROUTING & SSL CERTIFICATES
# ------------------------------------------------------------------------------
# Root apex domain for wildcard subdomains (e.g. al-furqan.ankabit.app)
NEXT_PUBLIC_ROOT_DOMAIN="ankabit.app"
ACME_EMAIL="admin@ankabit.app"

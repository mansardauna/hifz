# ==============================================================================
# ANKABIT LMS PRODUCTION ENVIRONMENT TEMPLATE (.env.production.template)
# Copy this file to .env.production on your production server:
# cp .env.production.template .env.production
# ==============================================================================

# 1. DATABASE CONFIGURATION (Prisma ORM - MySQL / MariaDB)
DATABASE_URL="mysql://your_db_user:change_to_a_strong_db_password_2026@mysql:3306/ankabit_lms?connection_limit=25&pool_timeout=30"
DB_ROOT_PASSWORD="change_to_a_strong_root_password_2026"
DB_NAME="ankabit_lms"
DB_USER="ankabit"
DB_PASSWORD="change_to_a_strong_db_password_2026"

# 2. REDIS
REDIS_URL="redis://:change_to_a_strong_redis_password_2026@redis:6379"
REDIS_PASSWORD="change_to_a_strong_redis_password_2026"

# 3. SECURITY & AUTH (Generate: openssl rand -base64 32)
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_GENERATED_SECRET"
NEXTAUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32_GENERATED_SECRET"

# 4. LIVEKIT WEBRTC SFU (Virtual Classroom)
LIVEKIT_URL="wss://your-project.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"

# 5. STRIPE BILLING (Production Live Keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_live_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_live_your_live_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_live_stripe_webhook_signing_secret"

# 6. MOYASAR GATEWAY (Saudi Mada / Apple Pay Live Keys)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY="pk_live_your_live_moyasar_publishable_key"
MOYASAR_SECRET_KEY="sk_live_your_live_moyasar_secret_key"

# 7. CLOUDFLARE R2 OBJECT STORAGE (Media / Student Audio Recitations)
R2_ACCOUNT_ID="your_cloudflare_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ankabit-lms-assets"
R2_PUBLIC_DOMAIN="media.ankabit.app"

# 8. MULTI-CHANNEL COMMUNICATIONS
RESEND_API_KEY="re_your_live_resend_api_key"
EMAIL_FROM="admissions@ankabit.app"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# 9. DOMAIN & SSL CONFIGURATION
NEXT_PUBLIC_ROOT_DOMAIN="your-platform-domain.com"
NEXT_PUBLIC_DEMO_MODE="false"
ACME_EMAIL="admin@your-platform-domain.com"
